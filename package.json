{
  "name": "irodori",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --outDir .dist-tmp --emptyOutDir && node scripts/strip-wasm.mjs .dist-tmp && rm -rf dist && mv .dist-tmp dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "sync-slides": "node scripts/sync-slide-studio.mjs",
    "agent": "npm run build && node agent/server.mjs",
    "agent:serve": "node agent/server.mjs",
    "mcp": "node agent/mcp.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "prebuild": "node -e \"process.exit(require('fs').existsSync('public/icons/index.json')?0:1)\" || npm run icons",
    "predev": "node -e \"process.exit(require('fs').existsSync('public/icons/index.json')?0:1)\" || npm run icons"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "fabric": "^7.4.0",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "lib0": "^0.2.119",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/fxemoji": "^1.2.2",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/noto": "^1.2.9",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.41",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.142.0"
  },
  "license": "MIT"
}
